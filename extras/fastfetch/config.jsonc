{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Panacea-style: logo and keys in the terminal's red (follows the Omarchy
  // theme palette), values white, dim dividers. Delete this file to get
  // Omarchy's default back (/etc/fastfetch/config.jsonc).
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/branding/about.txt",
    "color": { "1": "red" },
    "padding": { "top": 2, "left": 2, "right": 6 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "white", "output": "white", "separator": "90" }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "separator", "string": "·" },
    { "type": "wm",       "key": "● WM      " },
    { "type": "os",       "key": "● OS      ", "format": "{name} {arch}" },
    { "type": "kernel",   "key": "● Kernel  ", "format": "{release}" },
    { "type": "uptime",   "key": "● Uptime  " },
    { "type": "packages", "key": "● Packages", "format": "{pacman} pacman" },
    "break",
    { "type": "terminal", "key": "● Terminal", "format": "{pretty-name}" },
    { "type": "shell",    "key": "● Shell   ", "format": "{pretty-name} {version}" },
    { "type": "cpu",      "key": "● CPU     ", "format": "{name}" },
    { "type": "gpu",      "key": "● GPU     ", "format": "{name}" },
    { "type": "memory",   "key": "● Memory  " },
    { "type": "disk",     "key": "● Disk    ", "folders": "/" },
    { "type": "battery",  "key": "● Battery ", "format": "{capacity} ({status})" },
    "break",
    { "type": "separator", "string": "·" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
    "break"
  ]
}
